#!/bin/bash
# 投資儀表板啟動器。雙擊 .app 時執行。
# 行為：伺服器沒在跑就啟動它；已經在跑就直接開瀏覽器分頁。
#
# 沒在跑的時候，實際啟動動作借終端機的身分執行（見下方），
# 原因寫在 launch/run_dashboard.sh 開頭。

set -u
URL="http://127.0.0.1:5173/"

# 從 .app/Contents/MacOS/ 往上三層回到專案根目錄
# 用實體路徑解析：經由桌面捷徑（符號連結）啟動時，
# 邏輯路徑的 ".." 會走到捷徑所在的資料夾而不是專案，因此必須用 cd -P / pwd -P。
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && cd ../../../.. && pwd -P)"
cd "$ROOT" || exit 1

# 確認算出來的路徑真的是專案，而不是隨便一個資料夾。
# 沒有這道檢查的話，.app 一旦被「複製」到桌面（而不是做符號連結），
# 路徑會解析到家目錄，然後它會在那裡建一個 data/ 資料夾、
# 把錯誤寫進 ~/data/app.log，而你在專案裡怎麼找都找不到。
if [ ! -f "$ROOT/webapp/app.py" ]; then
  osascript -e 'display alert "找不到專案資料夾" message "這個捷徑必須留在專案資料夾裡，或用「符號連結」的方式放到桌面——直接複製一份到桌面是不行的，它會找不到程式。

正確做法：在專案資料夾裡雙擊 launch/安裝.command，它會自動建立正確的捷徑。

（目前解析到的位置：'"$ROOT"'）" as critical' >/dev/null 2>&1
  exit 1
fi

alive() { curl -s -o /dev/null --max-time 2 "$URL"; }

if alive; then
  open "$URL"
  exit 0
fi

RUN_SCRIPT="$ROOT/launch/run_dashboard.sh"
if [ ! -f "$RUN_SCRIPT" ]; then
  osascript -e 'display alert "找不到啟動腳本" message "launch/run_dashboard.sh 不見了，專案可能沒更新完整。" as critical' >/dev/null 2>&1
  exit 1
fi

# 借終端機的身分執行，見檔案開頭的說明。
ESCAPED_ROOT="$(printf '%s' "$ROOT" | sed 's/\\/\\\\/g; s/"/\\"/g')"
osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  do script "cd \"$ESCAPED_ROOT\" && bash launch/run_dashboard.sh"
end tell
APPLESCRIPT
